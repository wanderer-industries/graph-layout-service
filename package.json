{
  "name": "graph-layout-service",
  "version": "0.1.0",
  "description": "Deterministic HTTP graph layout service for Wanderer",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanderer-industries/graph-layout-service.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "test": "npm run build && node --import tsx --test test/**/*.test.ts",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "benchmark": "node --import tsx benchmark/run.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@opentelemetry/api": "^1.9.0",
    "ajv": "^8.17.1",
    "elkjs": "^0.12.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
